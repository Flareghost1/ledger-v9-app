# secrets.toml 예시 — 실제 값을 채운 뒤 이 파일을 "secrets.toml"로 복사해서 쓰세요.
# secrets.toml 자체는 .gitignore에 의해 git에 절대 올라가지 않습니다.
#
# 로컬에서 쓸 때: 이 폴더(.streamlit/)에 secrets.toml 로 저장하면 자동으로 읽힙니다.
#
# ※ Hugging Face Spaces에 배포할 때는 이 파일이 아니라 **환경변수**로 넣습니다
#   (Space → Settings → Variables and secrets). 이름은 아래와 같이 대문자로:
#     OWNER_PASSWORD
#     GDRIVE_SERVICE_ACCOUNT_JSON   (JSON 전체를 그대로 값으로)
#     GDRIVE_FOLDER_ID
#   코드(src/secretsutil.py)가 secrets.toml과 환경변수 둘 다 지원하므로 호스트를 바꿔도 수정 불필요.

# "본인" 프로필 진입 시 요구할 비밀번호. 원하는 문자열로 바꾸세요.
owner_password = "여기에_비밀번호_입력"

[gdrive]
# 구글 클라우드 콘솔에서 발급한 서비스 계정 키 JSON 전체를 그대로 붙여넣으세요(따옴표 3개로 감싸기).
service_account_json = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com",
  ...
}
'''
# 원장 데이터를 넣어둘 구글 드라이브 폴더의 ID (폴더를 열었을 때 주소창의 마지막 부분)
folder_id = "구글드라이브_폴더_ID"
